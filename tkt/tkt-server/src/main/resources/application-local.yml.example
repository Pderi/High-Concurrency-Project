# 本地覆盖配置示例：复制为 application-local.yml 后按需修改
# 启动：--spring.profiles.active=local
# application-local.yml 已加入 .gitignore，勿提交真实密码

server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/ticket?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: root
  data:
    redis:
      host: 127.0.0.1
      port: 6379

logging:
  level:
    com.hc.ticket: DEBUG
